# Aiment Wallet: variables de entorno.
# En local NO se edita a mano: `pnpm local:env` genera .env a partir de `supabase status`.
# Nunca subir .env ni credenciales reales al repositorio.

# --- Base de datos -----------------------------------------------------------
# Admin: migraciones y seed (nunca lo usa la API).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# API: usuario con login miembro de app_api (sin BYPASSRLS). Lo crea `pnpm db:roles`.
APP_DB_USER=aiment_api
APP_DB_PASSWORD=cambia-esta-clave-local
DATABASE_URL=postgresql://aiment_api:cambia-esta-clave-local@127.0.0.1:54322/postgres

# --- Supabase Auth -----------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Solo para seed y administración de usuarios (nunca en el frontend).
SUPABASE_SECRET_KEY=
# Solo local/legacy (HS256). En producción la API valida con JWKS.
SUPABASE_JWT_SECRET=
# En producción: true (superadmin con TOTP obligatorio).
AUTH_REQUIRE_SUPERADMIN_MFA=false

# --- Datos de prueba ---------------------------------------------------------
SEED_USER_PASSWORD=aiment-demo-2026

# --- API ---------------------------------------------------------------------
API_PORT=8787
PUBLIC_BASE_URL=http://localhost:5173

# --- Wallet ------------------------------------------------------------------
# fake = Wallet simulado (local). google/apple se activan en las semanas 7-8.
WALLET_PROVIDER=fake
# Prueba de Google Wallet en modo demo (ver docs/guia-google-wallet-demo.md)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON_PATH=./secrets/google-wallet-sa.json
GOOGLE_DEMO_LOGO_URL=
